function foo(i32): i32 {
entry:
    ldarg   #0
    ldc     i32 0xFFFF
    iadd
    ret
}

function fib(i32): i32 {
entry:
    ldarg   #0
    ldc     i32 2
    isgt
    brtrue  L1
    ldarg   #0
    ret

L1:
    ldarg   #0
    ldc     i32 1
    isub
    call    fib
    ldarg   #0
    ldc     i32 2
    isub
    call    fib
    iadd
    ret
}
