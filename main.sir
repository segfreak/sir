function foo(x: i32): i32 {
entry:
    ldarg #x
    ldc i32 0xFFFF
    iadd
    ret
}

function fib(x: i32): i32 {
entry:
    ldarg #x
    ldc i32 2
    sgt
    brtrue L1
    ldarg #0
    ret

L1:
    ldarg #x
    ldc i32 1
    isub
    call fib
    ldarg #x
    ldc i32 2
    isub
    call fib
    iadd
    ret
}